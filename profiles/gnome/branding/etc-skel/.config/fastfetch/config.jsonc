{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/spectre/spectre-ascii.txt",
    "color": { "1": "blue", "2": "cyan" },
    "padding": { "right": 2 }
  },
  "display": {
    "separator": "  ",
    "key": { "type": "string", "width": 10 }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "shell",
    "display",
    "de",
    "wm",
    "theme",
    "terminal",
    "cpu",
    "memory",
    "disk",
    "localip",
    "break",
    "colors"
  ]
}
