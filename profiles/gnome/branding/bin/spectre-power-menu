#!/usr/bin/env python3
"""Spectre Power User menu for Super+X."""
from __future__ import annotations
import subprocess
import gi
gi.require_version('Gtk','4.0'); gi.require_version('Adw','1')
from gi.repository import Adw, Gio, Gtk

APP_ID='com.spectre.PowerMenu'
ACTIONS=[
 ('folder-symbolic','Files','Browse files',['/usr/local/bin/spectre-files']),
 ('utilities-terminal-symbolic','Terminal','Open a terminal',['gnome-terminal']),
 ('org.gnome.SystemMonitor-symbolic','System Monitor','Processes and resources',['gnome-system-monitor']),
 ('network-wired-symbolic','Network Connections','Network settings',['gnome-control-center','network']),
 ('preferences-system-symbolic','Spectre Center','System controls',['spectre-center']),
 ('system-lock-screen-symbolic','Lock','Lock this session',['loginctl','lock-session']),
 ('media-playback-pause-symbolic','Suspend','Suspend the computer',['systemctl','suspend']),
 ('system-log-out-symbolic','Sign Out','End this session',['gnome-session-quit','--logout']),
 ('system-reboot-symbolic','Restart','Restart with confirmation',['gnome-session-quit','--reboot']),
 ('system-shutdown-symbolic','Shut Down','Power off with confirmation',['gnome-session-quit','--power-off']),
]
class App(Adw.Application):
 def __init__(self): super().__init__(application_id=APP_ID)
 def do_activate(self):
  if self.props.active_window: self.props.active_window.present(); return
  w=Adw.ApplicationWindow(application=self,title='Spectre Power User'); w.set_default_size(520,660)
  tv=Adw.ToolbarView(); hb=Adw.HeaderBar(); hb.set_title_widget(Adw.WindowTitle(title='Spectre Power User',subtitle='Quick system actions')); tv.add_top_bar(hb)
  sc=Gtk.ScrolledWindow(); box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=14); box.set_margin_top(18); box.set_margin_bottom(18); box.set_margin_start(18); box.set_margin_end(18)
  group=Adw.PreferencesGroup()
  for icon,title,sub,cmd in ACTIONS:
   r=Adw.ActionRow(title=title,subtitle=sub,activatable=True); r.add_prefix(Gtk.Image.new_from_icon_name(icon)); r.add_suffix(Gtk.Image.new_from_icon_name('go-next-symbolic')); r.connect('activated',self._go,cmd,w); group.add(r)
  box.append(group); sc.set_child(box); tv.set_content(sc); w.set_content(tv); w.present(); self.win=w
 def _go(self,_row,cmd,w):
  try: subprocess.Popen(cmd,start_new_session=True); w.close()
  except OSError as exc: print(f'Spectre Power User: {exc}')
if __name__=='__main__': raise SystemExit(App().run(None))
