#!/bin/sh
# Spectre OS recovery entries. Normal boot remains quiet and is generated by
# Debian's standard 10_linux. These entries are deliberately conservative:
# Safe Graphics adds nomodeset; Diagnostics uses text mode and visible status.
set -e

root_uuid="$(awk '$2=="/" && $1 ~ /^UUID=/ {sub(/^UUID=/,"",$1); print $1; exit}' /etc/fstab 2>/dev/null || true)"
[ -n "$root_uuid" ] || exit 0

kernel="$(find /boot -maxdepth 1 -type f -name 'vmlinuz-*-spectre' -printf '%f\n' 2>/dev/null | sort -V | tail -1)"
[ -n "$kernel" ] || exit 0
version="${kernel#vmlinuz-}"
initrd="initrd.img-$version"
[ -s "/boot/$initrd" ] || exit 0

cat <<EOF
menuentry 'Spectre OS — Safe Graphics' --class spectre --class gnu-linux --class gnu --class os {
    search --no-floppy --fs-uuid --set=root $root_uuid
    linux /boot/$kernel root=UUID=$root_uuid ro nomodeset quiet splash loglevel=3 systemd.show_status=false rd.systemd.show_status=false
    initrd /boot/$initrd
}
menuentry 'Spectre OS — Diagnostics (text mode)' --class spectre --class gnu-linux --class gnu --class os {
    search --no-floppy --fs-uuid --set=root $root_uuid
    linux /boot/$kernel root=UUID=$root_uuid ro systemd.unit=multi-user.target loglevel=4 systemd.show_status=true rd.systemd.show_status=true
    initrd /boot/$initrd
}
EOF
