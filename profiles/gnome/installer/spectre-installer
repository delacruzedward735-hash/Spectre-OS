    def _rotate_install_slide(self):
        if not self.installing or not hasattr(self, "install_slide_stack"):
            return GLib.SOURCE_REMOVE
        names = self.install_slide_names
        if names:
            self._slide_index = (self._slide_index + 1) % len(names)
            self.install_slide_stack.set_visible_child_name(names[self._slide_index])
        return GLib.SOURCE_CONTINUE

    def _password_strength_changed(self, editable):
        value = editable.get_text()
        score = 0
        if len(value) >= 8: score += 1
        if len(value) >= 12: score += 1
        if re.search(r"[A-Z]", value) and re.search(r"[a-z]", value): score += 1
        if re.search(r"[0-9]", value) and re.search(r"[^A-Za-z0-9]", value): score += 1
        self.password_strength.set_value(score)
        labels = ["Too short", "Basic", "Fair", "Good", "Strong"]
        self.password_strength_label.set_text(labels[min(score, 4)])

    def _update_detection_card(self):
        if not hasattr(self, "detection_title"):
            return
        d = self.selected_disk
        if not d:
            self.detection_title.set_text("No target selected")
            self.detection_detail.set_text("Select an eligible disk to see the installation safety assessment.")
            self.detection_state.set_text("WAITING")
            return
        if not d.partitions:
            self.detection_title.set_text("Empty disk detected")
            self.detection_detail.set_text(f"{d.path} has no existing partitions. Erase-disk installation can use the full {human_bytes(d.size)} safely after confirmation.")
            self.detection_state.set_text("READY")
            self.detection_state.remove_css_class("status-warn"); self.detection_state.add_css_class("status-good")
        elif d.windows_like:
            self.detection_title.set_text("Windows-compatible layout detected")
            if d.alongside_ready:
                detail = f"EFI + NTFS layout found with {human_bytes(d.largest_gap)} unallocated. The privileged backend will verify Microsoft Boot Manager before any alongside write."
                state = "ALONGSIDE READY"
            else:
                detail = "EFI + NTFS layout found, but safe alongside requirements are not all satisfied. Existing partitions remain untouched until final validation."
                state = "REVIEW"
            self.detection_detail.set_text(detail); self.detection_state.set_text(state)
            self.detection_state.remove_css_class("status-good"); self.detection_state.add_css_class("status-warn" if not d.alongside_ready else "status-good")
        else:
            self.detection_title.set_text("Existing partitions detected")
            self.detection_detail.set_text("Spectre found existing disk data but did not confirm a supported Windows alongside layout. Erase mode remains available; no changes occur until Summary confirmation.")
            self.detection_state.set_text("REVIEW")
            self.detection_state.remove_css_class("status-good"); self.detection_state.add_css_class("status-warn")

