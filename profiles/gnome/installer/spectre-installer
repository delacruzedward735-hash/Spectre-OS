def run_text(args: list[str]) -> str:
    try:
        return subprocess.check_output(args, text=True, stderr=subprocess.DEVNULL).strip()
    except Exception:
        return ""


def human_bytes(n: int) -> str:
    value = float(n)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if value < 1024 or unit == "TiB":
            return f"{value:.1f} {unit}" if unit != "B" else f"{int(value)} B"
        value /= 1024
    return f"{n} B"


def live_disk() -> str:
    source = run_text(["findmnt", "-no", "SOURCE", "/run/live/medium"])
    if not source:
        source = run_text(["findmnt", "-no", "SOURCE", "/lib/live/mount/medium"])
    if not source.startswith("/dev/"):
        return ""
    current = os.path.realpath(source)
    for _ in range(6):
        dtype = run_text(["lsblk", "-ndo", "TYPE", current])
        if dtype == "disk":
            return current
        parent = run_text(["lsblk", "-ndo", "PKNAME", current])
        if not parent:
            return ""
        current = f"/dev/{parent}"
    return ""


@dataclass
class DiskInfo:
    path: str
    size: int
    model: str
    serial: str
    removable: bool
    pttype: str
    windows_like: bool = False
    esp_path: str = ""
    largest_gap: int = 0
    eligible: bool = True
    reason: str = ""
    partitions: list[dict] = field(default_factory=list)

    @property
    def alongside_ready(self) -> bool:
        return (
            self.eligible
            and self.pttype == "gpt"
            and self.windows_like
            and bool(self.esp_path)
            and self.largest_gap >= MIN_ALONGSIDE_FREE
            and Path("/sys/firmware/efi").exists()
        )


def scan_disks() -> list[DiskInfo]:
    live = os.path.realpath(live_disk()) if live_disk() else ""
    cols = "PATH,NAME,TYPE,SIZE,MODEL,SERIAL,RO,RM,FSTYPE,LABEL,PARTLABEL,PARTTYPE,START,PKNAME,LOG-SEC,PTTYPE"
    try:
        raw = subprocess.check_output(["lsblk", "-J", "-b", "-o", cols], text=True)
        data = json.loads(raw)
    except Exception:
        return []

    results: list[DiskInfo] = []
    for dev in data.get("blockdevices", []):
        if dev.get("type") != "disk":
            continue
        path = dev.get("path") or ""
        size = int(dev.get("size") or 0)
        ro = bool(dev.get("ro"))
        rm = bool(dev.get("rm"))
        model = (dev.get("model") or "Unknown").strip()
        serial = (dev.get("serial") or "Not reported").strip()
        pttype = (dev.get("pttype") or "").lower()
        info = DiskInfo(path, size, model, serial, rm, pttype)
        if not path or path.startswith(("/dev/loop", "/dev/zram")):
            info.eligible, info.reason = False, "Unsupported device"
        elif live and os.path.realpath(path) == live:
            info.eligible, info.reason = False, "Spectre live installer media"
        elif ro:
            info.eligible, info.reason = False, "Read-only disk"
        elif size < MIN_DISK:
            info.eligible, info.reason = False, "Smaller than 32 GiB"

        parts = dev.get("children") or []
        info.partitions = parts
        sector = int(dev.get("log-sec") or 512)
        intervals: list[tuple[int, int]] = []
        ntfs = False
        esp = ""
        for part in parts:
            if part.get("type") != "part":
                continue
            start = int(part.get("start") or 0) * sector
            psize = int(part.get("size") or 0)
            if psize:
                intervals.append((start, min(size, start + psize)))
            fstype = (part.get("fstype") or "").lower()
            ptype = (part.get("parttype") or "").lower()
            label = (part.get("label") or "").lower()
            if fstype in {"ntfs", "ntfs3"} or "windows" in label:
                ntfs = True
            if ptype == EFI_GUID or ((fstype in {"vfat", "fat", "fat32"}) and "efi" in label):
                esp = part.get("path") or esp

        # Find the largest unallocated gap. Leave 4 MiB at each disk edge to
        # avoid GPT metadata/alignment areas and count only meaningful gaps.
        intervals.sort()
        cursor = 4 * 1024**2
        largest = 0
        for start, end in intervals:
            if start > cursor:
                largest = max(largest, start - cursor)
            cursor = max(cursor, end)
        disk_end = max(cursor, size - 4 * 1024**2)
        if size - 4 * 1024**2 > cursor:
            largest = max(largest, size - 4 * 1024**2 - cursor)
        info.largest_gap = max(0, largest)
        info.windows_like = ntfs and bool(esp)
        info.esp_path = esp
        results.append(info)
    return results


def timezones() -> list[str]:
    zones: list[str] = []
    for filename in ("/usr/share/zoneinfo/zone1970.tab", "/usr/share/zoneinfo/zone.tab"):
        try:
            for line in Path(filename).read_text(errors="ignore").splitlines():
                if not line or line.startswith("#"):
                    continue
                cols = line.split("\t")
                if len(cols) >= 3:
                    zones.append(cols[2])
            if zones:
                break
        except OSError:
            pass
    zones.extend(["Etc/UTC", "Asia/Manila"])
    return sorted(set(zones))


