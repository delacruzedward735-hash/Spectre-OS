    def _refresh_disks(self):
        self.disks = scan_disks()
        while child := self.disk_list.get_first_child():
            self.disk_list.remove(child)
        self.disk_buttons = {}
        eligible = [d for d in self.disks if d.eligible]
        self.disk_summary.set_text(f"{len(eligible)} eligible installation disk(s) detected")
        first = None
        for d in self.disks:
            row = Gtk.ListBoxRow(); box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12); box.add_css_class("disk-row")
            radio = Gtk.CheckButton()
            if first is None and d.eligible:
                first = radio
            elif first is not None:
                radio.set_group(first)
            radio.set_sensitive(d.eligible)
            radio.connect("toggled", self._disk_changed, d.path)
            box.append(radio)
            info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3); info.set_hexpand(True)
            title = Gtk.Label(label=f"{d.path} — {human_bytes(d.size)} — {d.model}"); title.set_xalign(0)
            subparts = ["Removable" if d.removable else "Internal", f"Serial: {d.serial}"]
            if d.windows_like: subparts.append("Windows/NTFS detected")
            if d.largest_gap: subparts.append(f"Unallocated: {human_bytes(d.largest_gap)}")
            if not d.eligible: subparts.append(d.reason)
            sub = Gtk.Label(label=" • ".join(subparts)); sub.set_xalign(0); sub.add_css_class("dim-label"); sub.set_wrap(True)
            info.append(title); info.append(sub); box.append(info); row.set_child(box); self.disk_list.append(row)
            self.disk_buttons[d.path] = radio
        if eligible:
            selected = self.selected_disk.path if self.selected_disk and any(d.path == self.selected_disk.path and d.eligible for d in self.disks) else eligible[0].path
            self.disk_buttons[selected].set_active(True)
        else:
            self.selected_disk = None
            self._update_mode_availability()
        self._update_detection_card()

    def _disk_changed(self, button: Gtk.CheckButton, path: str):
        if not button.get_active(): return
        self.selected_disk = next((d for d in self.disks if d.path == path), None)
        self._update_mode_availability()
        self._update_detection_card()

    def _update_mode_availability(self):
        d = self.selected_disk
        ready = bool(d and d.alongside_ready)
        self.along_mode.set_sensitive(ready)
        if d and d.windows_like and not ready:
            reasons = []
            if not Path("/sys/firmware/efi").exists(): reasons.append("boot the installer in UEFI mode")
            if d.pttype != "gpt": reasons.append("Windows disk is not GPT")
            if d.largest_gap < MIN_ALONGSIDE_FREE: reasons.append("at least 36 GiB unallocated space is required")
            self.along_desc.set_text("Windows was detected, but safe automatic alongside installation is unavailable: " + "; ".join(reasons) + ". Shrink Windows from Windows Disk Management first, then rescan.")
        elif ready:
            self.along_desc.set_text(f"Windows detected. Spectre can use {human_bytes(d.largest_gap)} of existing unallocated space without formatting the Windows partitions or EFI partition.")
        else:
            self.along_desc.set_text("Available only when a UEFI/GPT Windows installation and at least 36 GiB of unallocated space are detected.")
        if not ready and self.along_mode.get_active():
            self.erase_mode.set_active(True)
        self._update_detection_card()

    def _mode_changed(self, button: Gtk.CheckButton, mode: str):
        if button.get_active(): self.mode = mode

    def _selected_language(self) -> str:
        return LANGUAGES[min(self.language.get_selected(), len(LANGUAGES)-1)][1]

    def _selected_keyboard(self) -> str:
        return KEYBOARDS[min(self.keyboard.get_selected(), len(KEYBOARDS)-1)][1]

    def _selected_zone(self) -> str:
        return self._zone_selected if self._zone_selected in self.zone_values else "Etc/UTC"

    def _select_zone(self, zone_name: str):
        if zone_name not in self.zone_values:
            return
        self._zone_selected = zone_name
        self.zone_selected_title.set_text(zone_name.replace("_", " "))
        self.zone_selected_subtitle.set_text("Selected time zone • saved to the installed system")
        if hasattr(self, "zone_search"):
            self.zone_search.set_text("")
        self._refresh_zone_clock()

    def _refresh_zone_clock(self):
        try:
            now = datetime.now(ZoneInfo(self._selected_zone()))
            self.zone_clock.set_text(now.strftime("%a %H:%M"))
        except (ZoneInfoNotFoundError, ValueError):
            self.zone_clock.set_text("")
        return GLib.SOURCE_CONTINUE

    def _zone_search_changed(self, entry: Gtk.SearchEntry):
        query = entry.get_text().strip().casefold().replace("_", " ")
        child = self.zone_results.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            self.zone_results.remove(child)
            child = nxt

        if not query:
            self.zone_results.set_visible(False)
            return

        words = [w for w in query.split() if w]
        matches = []
        for zone_name in self.zone_values:
            hay = zone_name.casefold().replace("_", " ").replace("/", " ")
            if all(word in hay for word in words):
                score = 0
                city = zone_name.rsplit("/", 1)[-1].casefold().replace("_", " ")
                if city == query: score += 100
                if city.startswith(query): score += 60
                if hay.startswith(query): score += 30
                matches.append((-score, zone_name))
        matches.sort(key=lambda item: (item[0], item[1]))

        for _score, zone_name in matches[:12]:
            row = Gtk.ListBoxRow()
            row._spectre_zone = zone_name
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            box.set_margin_top(8); box.set_margin_bottom(8); box.set_margin_start(12); box.set_margin_end(12)
            icon = Gtk.Image.new_from_icon_name("preferences-system-time-symbolic")
            box.append(icon)
            labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1); labels.set_hexpand(True)
            city = zone_name.rsplit("/", 1)[-1].replace("_", " ")
            primary = Gtk.Label(label=city); primary.set_xalign(0)
            secondary = Gtk.Label(label=zone_name.replace("_", " ")); secondary.set_xalign(0); secondary.add_css_class("dim-label")
            labels.append(primary); labels.append(secondary); box.append(labels)
            row.set_child(box)
            self.zone_results.append(row)
        self.zone_results.set_visible(bool(matches))

    def _zone_row_activated(self, _listbox: Gtk.ListBox, row: Gtk.ListBoxRow):
        zone_name = getattr(row, "_spectre_zone", None)
        if zone_name:
            self._select_zone(zone_name)

    def _validate_current(self) -> bool:
        if self.page_index == 2:
            if not self.selected_disk:
                self._message("No installation disk", "No eligible target disk was selected.")
                return False
            if self.mode == "alongside" and not self.selected_disk.alongside_ready:
                self._message("Alongside installation is not ready", "Spectre only enables alongside mode when Windows is detected on a GPT disk, the installer is booted in UEFI mode, and at least 36 GiB of unallocated space already exists.")
                return False
        elif self.page_index == 4:
            full = self.fullname.get_text().strip()
            user = self.username.get_text().strip().lower()
            host = self.hostname.get_text().strip().lower()
            p1, p2 = self.password.get_text(), self.password2.get_text()
            if not full:
                self._message("Your name is required", "Enter the name to display for your account."); return False
            if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,30}", user) or user == "root":
                self._message("Invalid username", "Use lowercase letters, numbers, _ or -, up to 31 characters. 'root' is reserved."); return False
            if not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", host):
                self._message("Invalid computer name", "Use letters, numbers and hyphens without starting or ending with a hyphen."); return False
            if len(p1) < 8:
                self._message("Password too short", "Use at least 8 characters."); return False
            if p1 != p2:
                self._message("Passwords do not match", "Retype the same password in both fields."); return False
            self.username.set_text(user); self.hostname.set_text(host)
        return True

    def _prepare_summary(self):
        d = self.selected_disk
        if not d: return
        mode_text = "Erase the entire disk" if self.mode == "erase" else "Install alongside Windows using unallocated space"
        extra = ""
        if self.mode == "alongside": extra = f"\nSafe unallocated space detected: {human_bytes(d.largest_gap)}\nExisting EFI partition: {d.esp_path} (will NOT be formatted)"
        self.summary.set_text(
            f"Installation type: {mode_text}\nTarget disk: {d.path}\nSize: {human_bytes(d.size)}\nModel: {d.model}\nSerial: {d.serial}{extra}\n\n"
            f"Language: {self._selected_language()}\nKeyboard: {self._selected_keyboard()}\nTime zone: {self._selected_zone()}\n"
            f"Account: {self.username.get_text()}\nComputer name: {self.hostname.get_text()}\nSwap file: {'Yes (2 GiB)' if self.swap_switch.get_active() else 'No'}\n"
            f"Installer boot mode: {'UEFI' if Path('/sys/firmware/efi').exists() else 'Legacy BIOS'}"
        )
        word = "ERASE" if self.mode == "erase" else "INSTALL"
        action = "permanently erase the selected disk" if self.mode == "erase" else "modify partitioning and install Spectre alongside the existing OS"
        self.confirm_label.set_markup(
            f"Final confirmation: type <b>{word}</b> to {GLib.markup_escape_text(action)} on <b>{GLib.markup_escape_text(d.path)}</b>."
        )
        self.confirm.set_text("")
        self.confirm_ack.set_active(False)
        self.confirm_ack.set_label(
            "I understand all data on the selected disk will be permanently erased."
            if self.mode == "erase"
            else "I understand Spectre will change this disk's partition layout and I have a current backup."
        )
        self.expected_confirmation = word
        self._update_install_confirmation()

    def _normalized_confirmation(self) -> str:
        return self.confirm.get_text().strip().upper()

    def _confirmation_ready(self) -> bool:
        return self.confirm_ack.get_active() and self._normalized_confirmation() == self.expected_confirmation

    def _update_install_confirmation(self, *_):
        if not hasattr(self, "next") or not hasattr(self, "confirm_state"):
            return
        if self.page_index != 5:
            return
        typed_ok = self._normalized_confirmation() == getattr(self, "expected_confirmation", "")
        acknowledged = self.confirm_ack.get_active()
        ready = typed_ok and acknowledged
        self.next.set_sensitive(ready and not self.installing)
        if ready:
            self.confirm_state.set_text("Ready. Spectre will re-check the target disk once more before writing anything.")
        elif not typed_ok:
            self.confirm_state.set_text(f"Type {getattr(self, 'expected_confirmation', 'the safety word')} above. Spaces and letter case are ignored.")
        else:
            self.confirm_state.set_text("Tick the acknowledgement box to enable Install.")

    def _next(self, *_):
        if self.installing: return
        if not self._validate_current(): return
        if self.page_index == 5:
            if not self._confirmation_ready():
                self._update_install_confirmation()
                return
            self._start_install()
            return
        if self.page_index < 5:
            self.page_index += 1
            if self.page_index == 5: self._prepare_summary()
            self._sync_page()

    def _back(self, *_):
        if self.installing or self.page_index == 0: return
        self.page_index -= 1
        self._sync_page()

    def _sync_page(self):
        self.stack.set_visible_child(self.pages[self.page_index])
        for i, label in enumerate(self.step_labels):
            if i == self.page_index: label.add_css_class("step-active")
            else: label.remove_css_class("step-active")
        self.back.set_sensitive(self.page_index > 0 and self.page_index < 6 and not self.installing)
        self.next.set_visible(self.page_index < 6)
        self.next.set_label("Install" if self.page_index == 5 else "Continue")
        self.next.set_sensitive(not self.installing)
        if self.page_index == 5:
            self._update_install_confirmation()
        self.status.set_text("No disk changes have been made" if self.page_index < 6 else "")

    def _plan(self) -> dict:
        assert self.selected_disk
        return {
            "mode": self.mode,
            "disk": self.selected_disk.path,
            "expected_size": self.selected_disk.size,
            "expected_serial": "" if self.selected_disk.serial == "Not reported" else self.selected_disk.serial,
            "full_name": self.fullname.get_text().strip(),
            "username": self.username.get_text().strip(),
            "hostname": self.hostname.get_text().strip(),
            "password": self.password.get_text(),
            "timezone": self._selected_zone(),
            "locale": self._selected_language(),
            "keyboard": self._selected_keyboard(),
            "swap": bool(self.swap_switch.get_active()),
            "confirmation": self._normalized_confirmation(),
            "acknowledged": bool(self.confirm_ack.get_active()),
        }

    def _on_close_request(self, *_args):
        if not self.installing:
            return False
        self._message(
            "Installation in progress",
            "Spectre OS is currently writing and verifying the target disk. "
            "The installer window cannot be closed until this operation finishes.",
        )
        return True

    def _start_install(self):
        self.installing = True
        self.page_index = 6
        self._sync_page()
        self.back.set_sensitive(False); self.next.set_visible(False)
        self._last_progress = 0
        self._last_backend_error = ""
        self.progress.set_fraction(0.0); self.progress.set_text("0%")
        self.progress_text.set_text("Starting the privileged installer…")
        self.elapsed_label.set_text("Elapsed 00:00")
        self._install_started_at = time.monotonic()
        self.install_spinner.start()
        if self._activity_timer:
            GLib.source_remove(self._activity_timer)
        self._activity_timer = GLib.timeout_add(120, self._activity_tick)
        plan = self._plan()
        self.password.set_text(""); self.password2.set_text("")
        self._slide_index = 0
        self.install_slide_stack.set_visible_child_name(self.install_slide_names[0])
        if self._slide_timer:
            GLib.source_remove(self._slide_timer)
        self._slide_timer = GLib.timeout_add_seconds(6, self._rotate_install_slide)

        def worker():
            try:
                proc = subprocess.Popen(
                    ["pkexec", "/usr/local/sbin/spectre-installer-backend", "--install-json"],
                    stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                    text=True, bufsize=1,
                )
                self._backend = proc
                assert proc.stdin and proc.stdout
                proc.stdin.write(json.dumps(plan)); proc.stdin.close()
                for line in proc.stdout:
                    line = line.rstrip("\n")
                    if line.startswith("PROGRESS|"):
                        _, pct, msg = line.split("|", 2)
                        GLib.idle_add(self._progress_update, int(pct), msg)
                    elif line.startswith("ERROR|"):
                        GLib.idle_add(self._backend_error, line[6:])
                    elif line.startswith("LOG|"):
                        GLib.idle_add(self._append_log, line[4:])
                    elif line.startswith("DONE|"):
                        GLib.idle_add(self._append_log, line[5:])
                    else:
                        GLib.idle_add(self._append_log, line)
                rc = proc.wait()
                GLib.idle_add(self._install_finished, rc)
            except Exception as exc:
                GLib.idle_add(self._append_log, f"Installer launcher error: {exc}")
                GLib.idle_add(self._install_finished, 1)
        threading.Thread(target=worker, daemon=True).start()

    def _activity_tick(self):
        if not self.installing:
            self._activity_timer = 0
            return GLib.SOURCE_REMOVE
        # This is intentionally separate from the trustworthy percentage bar:
        # pulse means the installer process is still running, not that a fake
        # amount of disk work has completed.
        self.activity_progress.pulse()
        elapsed = max(0, int(time.monotonic() - self._install_started_at))
        minutes, seconds = divmod(elapsed, 60)
        hours, minutes = divmod(minutes, 60)
        if hours:
            self.elapsed_label.set_text(f"Elapsed {hours:d}:{minutes:02d}:{seconds:02d}")
        else:
            self.elapsed_label.set_text(f"Elapsed {minutes:02d}:{seconds:02d}")
        return GLib.SOURCE_CONTINUE

    def _progress_update(self, pct: int, msg: str):
        self._last_progress = max(0, min(100, pct))
        self.progress.set_fraction(self._last_progress / 100)
        self.progress.set_text(f"{self._last_progress}%")
        self.progress_text.set_text(msg)
        self._append_log(f"[{self._last_progress:3d}%] {msg}")
        return False

    def _backend_error(self, text: str):
        self._last_backend_error = text.strip()
        self._append_log(f"ERROR: {self._last_backend_error}")
        return False

    def _append_log(self, text: str):
        buf = self.progress_log.get_buffer()
        end = buf.get_end_iter()
        buf.insert(end, text + "\n")
        end = buf.get_end_iter()
        self.progress_log.scroll_to_iter(end, 0.0, False, 0.0, 1.0)
        return False

    def _install_finished(self, rc: int):
        self.installing = False
        self.install_spinner.stop()
        if self._activity_timer:
            GLib.source_remove(self._activity_timer); self._activity_timer = 0
        if self._slide_timer:
            GLib.source_remove(self._slide_timer); self._slide_timer = 0
        if rc == 0:
            self.activity_progress.set_fraction(1.0)
            self.progress.set_fraction(1.0); self.progress.set_text("100%")
            self.progress_text.set_text("Spectre OS was installed and verified. Remove the installation USB/ISO before the next boot.")
            self.install_slide_stack.set_visible_child_name("finish")
            self.finish_box.set_visible(True)
        else:
            self.activity_progress.set_fraction(0.0)
            self.progress.set_text(f"Stopped at {self._last_progress}%")
            self.install_slide_stack.set_visible_child_name("failure")
            detail = self._last_backend_error or "The backend stopped before a verified installation was reported."
            self.progress_text.set_text(f"Installation paused safely — {detail}")
            self._message("Installation stopped", f"{detail}\n\nNo further disk operations will be performed. A detailed failure log is saved in Downloads when possible.")
        return False

    def _message(self, title: str, body: str):
        dialog = Adw.MessageDialog.new(self.win, title, body)
        dialog.add_response("ok", "OK"); dialog.set_default_response("ok")
        dialog.present()


def main():
    return Installer().run(None)


if __name__ == "__main__":
    raise SystemExit(main())
